# ---- AI fallback (recommended) ----
# Used to auto-classify merchants that the rule table cannot match.
# If empty, unknown rows are exported but flagged "UNCLASSIFIED" for manual fix.
OPENAI_API_KEY=
# gpt-4o-mini is cheap and accurate enough for this task.
OPENAI_MODEL=gpt-4o-mini

# ---- Shared learning store (recommended) ----
# Powers the "confirm once, applies for everyone" feature. When a user fixes an
# UNCLASSIFIED item in the popup, the merchant->category mapping is saved here so
# every future upload (by anyone) classifies it automatically.
#
# Easiest setup: in Vercel -> your project -> Storage -> create a KV (Upstash
# Redis) database and click "Connect". Vercel injects these two vars for you;
# you do NOT need to copy them by hand.
#
# Without these, the app still works but learned mappings reset on cold start.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- 회사 공용 비밀번호 (접근 제한) ----
# 이 값을 설정하면 앱에 들어올 때 비밀번호를 묻고, 맞게 입력한 사람만
# 30일간 접근할 수 있다(쿠키 유지). 회사 사람들에게 이 비밀번호만 공유하면 된다.
# Vercel -> 프로젝트 -> Settings -> Environment Variables 에서 설정.
# 비워두면 잠금 없이 누구나 접근 가능(현재 기본).
APP_PASSWORD=
