# ---- AI fallback (optional but recommended) ----
# Used ONLY for merchants that the rule table cannot classify.
# If left empty, unknown rows are still exported but flagged as "UNCLASSIFIED"
# so a human can fix them before submission.
OPENAI_API_KEY=

# Model used for fallback classification. gpt-4o-mini is cheap and accurate enough.
OPENAI_MODEL=gpt-4o-mini
